# Copy to .env (never commit .env). Keys are read from the environment only (G1.3).

# LLM provider: deepseek (default) | anthropic | openai_compat (any OpenAI-compatible endpoint, e.g. local)
GUARDIAN_LLM_PROVIDER=deepseek
# Defaults per provider: deepseek -> deepseek-chat @ https://api.deepseek.com ; anthropic -> claude-opus-5-5
GUARDIAN_MODEL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Only for openai_compat (or to override the DeepSeek URL)
LLM_BASE_URL=
LLM_API_KEY=

# live | record | replay   (replay serves data/cache/llm and fails closed when missing)
GUARDIAN_LLM_MODE=record

# Max findings sent to the evidence analyst per run (rest get the rule-based initial risk)
GUARDIAN_MAX_LLM_FINDINGS=200

# 1 = threat intel from cache only (Dev4)
GUARDIAN_OFFLINE=0

GUARDIAN_RUNS_DIR=runs
