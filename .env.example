# Copy to .env (never commit .env). Keys are read from the environment only (G1.3).

# LLM provider: anthropic (default) | openai_compat (any OpenAI-compatible endpoint, e.g. a local model)
GUARDIAN_LLM_PROVIDER=anthropic
GUARDIAN_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Only for GUARDIAN_LLM_PROVIDER=openai_compat
LLM_BASE_URL=
LLM_API_KEY=

# live | record | replay   (replay serves data/cache/llm and fails closed when missing)
GUARDIAN_LLM_MODE=live

# Max findings sent to the evidence analyst per run (rest get the rule-based initial risk)
GUARDIAN_MAX_LLM_FINDINGS=40

# 1 = threat intel from cache only (Dev4)
GUARDIAN_OFFLINE=0

GUARDIAN_RUNS_DIR=runs
